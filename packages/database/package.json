{
  "name": "@vision-codef/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --conditions=development --import=tsx/esm src/migrate.ts",
    "db:seed": "node --conditions=development --import=tsx/esm src/seed.ts"
  },
  "dependencies": {
    "@vision-codef/config": "workspace:*",
    "@vision-codef/contracts": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
