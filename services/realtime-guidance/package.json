{
  "name": "@vision-codef/realtime-guidance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --conditions=development --import=tsx/esm src/main.ts",
    "start": "node dist/main.js",
    "smoke:detector": "tsx scripts/smoke-detector.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@livekit/rtc-node": "0.13.34",
    "@vision-codef/contracts": "workspace:*",
    "dotenv": "16.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
