{
  "name": "@vision-codef/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build --force",
    "start": "node dist/server.js",
    "dev": "node --conditions=development --import=tsx/esm --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@temporalio/client": "1.23.0",
    "@vision-codef/contracts": "workspace:*",
    "@vision-codef/database": "workspace:*",
    "@vision-codef/workflow-engine": "workspace:*",
    "dotenv": "16.4.7",
    "livekit-server-sdk": "^2.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
