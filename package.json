{
  "name": "vision-codef",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "golden-run:start": "powershell -ExecutionPolicy Bypass -File scripts/start-golden-run.ps1",
    "golden-run:restart": "powershell -ExecutionPolicy Bypass -File scripts/start-golden-run.ps1 -Restart",
    "interaction:check": "node scripts/verify-interaction-inventory.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
