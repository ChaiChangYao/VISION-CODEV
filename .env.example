NODE_ENV=development
DATABASE_URL=postgresql://vision_codef:vision_codef@localhost:5432/vision_codef
VISION_CODEF_PERSISTENCE=postgres
VISION_CODEF_RUNTIME_STATE_PATH=
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vision-codef
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WEBHOOK_API_KEY=devkey
LIVEKIT_WEBHOOK_API_SECRET=devsecret
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
PROCESSING_WORKER_HEALTH_PORT=8093
PROCESSING_WORKER_HEALTH_URL=http://127.0.0.1:8093/health
TEMPORAL_SEARCH_ATTRIBUTES_ENABLED=false
VISION_CODEF_PROCESSING_PROVIDER_URL=
VISION_CODEF_VLM_PROVIDER=ollama
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_VISION_MODEL_VERSION=gpt-5-mini
VISION_CODEF_OPENAI_ADAPTER_VERSION=openai-responses-v1
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
VISION_CODEF_LOCAL_MEDIA_DIR=
VISION_CODEF_MAX_IMPORT_BYTES=262144000

VISION_CODEF_AUTH_SECRET=change-me-auth-secret
VISION_CODEF_ALLOWED_MEMBERS=00000000-0000-7000-8000-000000000001/00000000-0000-4000-8000-000000000002
VISION_CODEF_GUIDANCE_SERVICE_SECRET=change-me-guidance-service-secret

# Realtime guidance worker. Set a deployment ID only when starting the worker.
VISION_CODEF_DEPLOYMENT_ID=
VISION_CODEF_WORKFLOW_ID=
VISION_CODEF_GUIDANCE_FRAME_INTERVAL_MS=500
VISION_CODEF_VLM_ENDPOINT=
VISION_CODEF_VLM_BEARER_TOKEN=
VISION_CODEF_FIXTURE_OBSERVATION_JSON=

# Optional change-triggered mode. Start with frame-difference; switch to http for
# StreamFormer or another stateful detector without changing the live pipeline.
VISION_CODEF_CHANGE_DETECTOR=disabled
VISION_CODEF_CHANGE_THRESHOLD=0.12
VISION_CODEF_CHANGE_CONSECUTIVE_FRAMES=2
VISION_CODEF_CHANGE_PRE_ROLL_MS=2000
VISION_CODEF_CHANGE_POST_ROLL_MS=1000
VISION_CODEF_CHANGE_COOLDOWN_MS=2000
VISION_CODEF_CHANGE_MAX_EVIDENCE_FRAMES=8
VISION_CODEF_CHANGE_DETECTOR_ENDPOINT=
VISION_CODEF_CHANGE_DETECTOR_BEARER_TOKEN=
VISION_CODEF_CHANGE_DETECTOR_MODEL_ID=streamformer
VISION_CODEF_CHANGE_DETECTOR_MODEL_VERSION=
VISION_CODEF_EVENT_VLM_ENDPOINT=
VISION_CODEF_EVENT_VLM_BEARER_TOKEN=

NEXT_PUBLIC_COMPANY_ID=00000000-0000-7000-8000-000000000001
NEXT_PUBLIC_MEMBER_ID=00000000-0000-4000-8000-000000000002
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_DEMO_FIXTURES=false

EXPO_PUBLIC_CAPTURE_TOKEN_ENDPOINT=http://localhost:4000/v1/capture-token
LIVEKIT_EGRESS_S3_BUCKET=vision-codef
LIVEKIT_EGRESS_S3_ACCESS_KEY=change-me
LIVEKIT_EGRESS_S3_SECRET=change-me-secret
LIVEKIT_EGRESS_S3_REGION=us-east-1
LIVEKIT_EGRESS_S3_ENDPOINT=http://host.docker.internal:9000
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true
VISION_CODEF_MODEL_ID=vision-codef-paper-crane
VISION_CODEF_MODEL_VERSION=
VISION_CODEF_ADAPTER_VERSION=
VISION_CODEF_PROMPT_VERSION=
VISION_CODEF_DECODING_TEMPERATURE=0
VISION_CODEF_INPUT_MEDIA_HASHES=
VISION_CODEF_RETRIEVED_EVIDENCE_IDS=

EXPO_PUBLIC_COMPANY_ID=00000000-0000-7000-8000-000000000001
EXPO_PUBLIC_MEMBER_ID=00000000-0000-4000-8000-000000000002
EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880
EXPO_PUBLIC_CAPTURE_TOKEN_ENDPOINT=http://localhost:4000/v1/capture-token
EXPO_PUBLIC_CAPTURE_PAIRING_ENDPOINT=http://localhost:4000/v1/capture-pairings/claim
EXPO_PUBLIC_PAIRING_CODE=
EXPO_PUBLIC_DEVICE_ID=vision-codef-phone
EXPO_PUBLIC_WORKFLOW_ID=
EXPO_PUBLIC_SESSION_ID=
# Absolute phone-local directory containing an installed Piper/VITS model.
EXPO_PUBLIC_TTS_MODEL_PATH=

PROCESSING_COMPLETION_URL=http://localhost:4000/v1/internal/processing-completions
PROCESSING_PROGRESS_URL=http://localhost:4000/v1/internal/processing-progress
VISION_CODEF_PROCESSING_WEBHOOK_SECRET=change-me-processing-secret
